NODE_ENV=development
PORT=3000

# PostgreSQL connection string used by Prisma.
# Matches the credentials in docker-compose.yml for local development.
DATABASE_URL="postgresql://pgbackend:pgbackend@localhost:5432/pg_backend?schema=public"

# JWT secrets - MUST be replaced with strong, unique random values outside
# of local development (e.g. `openssl rand -base64 48`). Never reuse the
# access and refresh secrets.
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# Comma-separated list of origins allowed to call this API from a browser.
# The React Native/Expo mobile app is not subject to CORS, but a future
# admin web app would be listed here.
CORS_ORIGINS="http://localhost:19006"

# Reverse-proxy hops to trust for the client IP (Express 'trust proxy').
# Set to 1 behind Render or any load balancer - otherwise every client
# shares the proxy's IP and therefore ONE rate-limit bucket. 0 = direct.
TRUST_PROXY_HOPS=0

# Razorpay (Phase 6 - tenant payments). Use test-mode keys from the
# Razorpay dashboard for local development; never commit real keys.
RAZORPAY_KEY_ID="rzp_test_replace_with_key_id"
RAZORPAY_KEY_SECRET="replace-with-razorpay-key-secret"
# Signing secret configured on the Razorpay webhook endpoint, used to
# verify POST /payments/webhooks/razorpay - never trust an unverified body.
RAZORPAY_WEBHOOK_SECRET="replace-with-razorpay-webhook-secret"

# Owner SaaS subscription (Phase 7)
DEFAULT_TRIAL_DAYS=30
SUBSCRIPTION_GRACE_PERIOD_DAYS=7

# Platform admin bootstrap (Phase 8). Optional - when set, the user with
# this email is promoted to SUPER_ADMIN on every boot. There is no public
# Super Admin registration endpoint; leave unset in most environments.
SUPER_ADMIN_EMAIL=
