NODE_ENV=development
PORT=3000

# PostgreSQL connection string used by Prisma.
# Matches the credentials in docker-compose.yml for local development.
DATABASE_URL="postgresql://pg_backend:pg_backend@localhost:5432/pg_backend?schema=public"

# JWT secrets - MUST be replaced with strong, unique random values outside
# of local development (e.g. `openssl rand -base64 48`). Never reuse the
# access and refresh secrets.
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# Comma-separated list of origins allowed to call this API from a browser.
# The React Native/Expo mobile app is not subject to CORS, but a future
# admin web app would be listed here.
CORS_ORIGINS="http://localhost:19006"
