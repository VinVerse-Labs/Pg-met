generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

// Platform-wide role. SUPER_ADMIN is the only role that is meaningful without
// an OrganizationMembership (internal platform operators). Every other role
// is granted per-organization via OrganizationMembership.role.
enum PlatformRole {
  SUPER_ADMIN
  USER
}

enum MembershipRole {
  OWNER
  MANAGER
  STAFF
  STUDENT
}

// No INVITED here on purpose: Phase 2 does not implement the invitation
// flow (see MembershipsService docs) - a status this phase never sets is
// complexity with no purpose yet. REMOVED is distinct from a hard delete:
// the membership row (and its audit trail - who was a member, when) is
// kept, it just no longer grants access.
enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

// Deliberately separate from PropertyStatus even though the values
// currently overlap - an Organization being SUSPENDED is a platform-level
// moderation action (affects every property/member underneath it); a
// Property being ARCHIVED is an owner's own lifecycle decision. Conflating
// them would make a future "suspend this organization" feature accidentally
// also mean something different for properties.
enum OrganizationStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

// Extensible on purpose - "PG" is the UI's word for this, not the domain's.
// The table/enum stay provider-neutral so hostels/co-living/student housing
// are new enum values later, never a schema migration or a parallel model.
enum PropertyType {
  PG
  HOSTEL
  CO_LIVING
  STUDENT_HOUSING
}

// Extensible on purpose - identity/KYC is not Aadhaar-specific. New checks
// (e.g. a future selfie/liveness check) are new enum values, never a new
// boolean field bolted onto User or Tenant.
enum IdentityVerificationType {
  GOVERNMENT_ID
  ADDRESS_VERIFICATION
  AGE_VERIFICATION
}

// NOT_STARTED/PENDING/VERIFIED/FAILED/EXPIRED/REVOKED. Valid transitions are
// enforced in application code (IdentityVerificationService), not by a
// database CHECK constraint - the rules (e.g. FAILED -> PENDING allowed for
// a retry, REVOKED is terminal) are product policy that will evolve.
enum IdentityVerificationStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  FAILED
  EXPIRED
  REVOKED
}

// ARCHIVED is the soft-delete state: a property's DELETE endpoint archives
// rather than destroys the row, because a real PG accumulates rooms, beds,
// tenants and payment history underneath it that must never disappear.
enum PropertyStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

// Kept deliberately small - SINGLE/DOUBLE/TRIPLE/FOUR describe occupancy by
// bed count, DORMITORY is an open shared room, OTHER is the escape hatch
// rather than growing this enum for every edge case a listing might need.
enum RoomType {
  SINGLE
  DOUBLE
  TRIPLE
  FOUR
  DORMITORY
  OTHER
}

// ARCHIVED is the soft-delete state - see Room's DELETE endpoint. A room is
// never hard-deleted once beds (and, from Phase 4, allocation history) can
// reference it.
enum RoomStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

// AVAILABLE is the ordinary "in service" state (occupied or not - Phase 3
// has no allocation/tenant concept yet, so this enum says nothing about
// whether someone is currently in the bed). INACTIVE is a reversible
// operational pause (e.g. temporarily out of use); ARCHIVED is the
// soft-delete state set by the DELETE endpoint and is not reversed by this
// phase's API.
enum BedStatus {
  AVAILABLE
  INACTIVE
  ARCHIVED
}

// Phase 13: in-room features an owner advertises per room. Deliberately a
// separate enum from Amenity (which describes the whole property on its
// public listing - parking, gym, laundry). "Non-AC" is simply the absence
// of AC, not its own value.
enum RoomAmenity {
  AC
  WIFI
  TV
  FAN
  ALMARI
  STUDY_TABLE
  ATTACHED_WASHROOM
  GEYSER
  BALCONY
}

// Phase 13: optional position for bunk-bed layouts. Null means a regular
// (non-bunk) bed.
enum BedBerth {
  LOWER
  UPPER
}

// PENDING is the state a Residency is created in - a tenant has been
// scheduled to move into a property, but check-in (which assigns a bed via
// BedAllocation) hasn't happened yet. This is deliberately a separate step
// from check-in (see ResidenciesService/spec section 19): creating a
// residency and allocating a bed are two different decisions with two
// different atomicity boundaries, not one combined operation.
//
// NOTICE_PERIOD has no endpoint that sets it in Phase 4 - kept in the enum
// now (rather than added later) because it's part of the intended lifecycle
// shape and a future "give notice" action only needs a new endpoint, not a
// schema change or a migration. Same pattern as MembershipStatus.REMOVED in
// Phase 2, which also predates the endpoint that will eventually set it.
//
// Valid transitions (enforced in ResidenciesService, not by a DB CHECK
// constraint - see IdentityVerification for why application-level
// transition rules are preferred here): PENDING -> ACTIVE (check-in only),
// ACTIVE -> CHECKED_OUT and NOTICE_PERIOD -> CHECKED_OUT (check-out only).
// Nothing else is valid: a PENDING residency cannot check out without
// checking in first, and a CHECKED_OUT residency is terminal.
enum ResidencyStatus {
  PENDING
  ACTIVE
  NOTICE_PERIOD
  CHECKED_OUT
}

// ACTIVE = currently occupying the bed. Every other status is historical.
// Exactly one ACTIVE allocation may exist per bed, and exactly one ACTIVE
// residency may exist per tenant - enforced by partial unique indexes
// added by hand in the migration SQL (see BedAllocation/Residency docs).
enum BedAllocationStatus {
  ACTIVE
  ENDED
  CANCELLED
}

// Kept to exactly one value on purpose - Phase 5 has no weekly/yearly
// billing requirement, and an enum (rather than a free-text string) is
// what makes adding WEEKLY/YEARLY later a new value, not a data migration.
enum BillingCycle {
  MONTHLY
}

// Deliberately just two values, not a generic free-form status - the only
// controlled transition is ACTIVE -> INACTIVE (RentPlansService.deactivate,
// or implicitly when a new plan supersedes it), never a client-supplied
// arbitrary string. See RentPlan's doc comment for why amount changes
// create a new row instead of mutating this one.
enum RentPlanStatus {
  ACTIVE
  INACTIVE
}

// DRAFT is created by generation and is still editable; ISSUED is a
// financial snapshot (spec section 17 - immutable except through VOID);
// OVERDUE is a lazily-derived state (see InvoicesService.evaluateStatus) -
// there is no cron/job infrastructure in this project yet, so nothing
// proactively sweeps for overdue invoices; a read of an ISSUED invoice
// past its dueDate transitions it opportunistically. PARTIALLY_PAID/PAID
// are set by PaymentsService (Phase 6) once a successful PaymentAllocation
// brings the sum of successful allocations to, respectively, less than or
// equal to (but greater than zero) the invoice total. VOID is terminal and
// is never overwritten by a payment - a voided invoice cannot be paid.
enum InvoiceStatus {
  DRAFT
  ISSUED
  OVERDUE
  PARTIALLY_PAID
  PAID
  VOID
}

// Only RENT exists in Phase 5. Kept as an enum (not a free string) so
// SECURITY_DEPOSIT/FOOD/UTILITY/LATE_FEE/DISCOUNT/OTHER are new values
// later, never a schema change - but none of those billing features are
// implemented this phase, so only RENT is defined.
enum InvoiceItemType {
  RENT
}

// ---------------------------------------------------------------------------
// Tenant payments & platform settlement (Phase 6)
// ---------------------------------------------------------------------------

// Only one gateway is integrated in Phase 6. Kept as an enum (not a bare
// string) so a second provider is a new value later, never a schema
// change - same pattern as BillingCycle/InvoiceItemType.
enum PaymentProvider {
  RAZORPAY
}

// Mirrors Razorpay's own order/payment lifecycle rather than inventing a
// parallel one: CREATED (internal Payment row + gateway order created,
// nothing captured yet) -> PENDING/AUTHORIZED (gateway-reported
// intermediate states) -> CAPTURED (money received - the only state that
// ever creates a PaymentAllocation) -> FAILED/CANCELLED (terminal, no
// money moved) -> REFUNDED/PARTIALLY_REFUNDED (money returned after a
// prior CAPTURED). Transitions are enforced in PaymentsService, never by
// a client-supplied status field - see spec section 13.
enum PaymentStatus {
  CREATED
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

// Deliberately just FIXED for Phase 6 (spec section 19/20 - "do not build
// a complex fee engine unless necessary"). PERCENTAGE is a documented
// future value, not implemented by PlatformFeeService yet - adding it
// later is a new enum value, never a schema migration.
enum PlatformFeeType {
  FIXED
}

// PENDING - settlement recorded but not yet transferred to the owner's
// account; PROCESSING - transfer requested from the gateway; SETTLED -
// gateway confirmed the transfer; FAILED - the gateway could not
// complete it (tenant payment is NOT affected - see OwnerSettlement doc
// comment); REVERSED - a refund on the underlying payment required
// reversing a settlement that had already reached PROCESSING/SETTLED.
enum SettlementStatus {
  PENDING
  PROCESSING
  SETTLED
  FAILED
  REVERSED
}

// Mirrors the Razorpay Route "linked account" onboarding lifecycle -
// PENDING until the owner completes the gateway's own KYC/onboarding,
// ACTIVE once transfers can be created against it, SUSPENDED if the
// gateway disables it later.
enum OwnerPaymentAccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

// A webhook provider is deliberately its own enum (distinct from
// PaymentProvider) even though Phase 6 only ever writes RAZORPAY here -
// a future non-payment webhook source (e.g. a KYC vendor) would use the
// same WebhookEvent table with a different value, not a parallel table.
enum WebhookProvider {
  RAZORPAY
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

// ---------------------------------------------------------------------------
// Complaints & maintenance (Phase 9)
// ---------------------------------------------------------------------------

// Kept small on purpose (spec: "do not create dozens of categories") -
// OTHER is the deliberate escape hatch, the same pattern RoomType (Phase
// 3) already uses.
enum ComplaintCategory {
  PLUMBING
  ELECTRICAL
  WIFI
  CLEANING
  ROOM
  BED
  FURNITURE
  FOOD
  SECURITY
  MAINTENANCE
  OTHER
}

// A tenant may *suggest* a priority at creation time, but it is never
// trusted blindly (spec: "do not blindly trust tenant-supplied URGENT") -
// see ComplaintsService.create for the actual rule.
enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// OPEN -> ASSIGNED -> IN_PROGRESS -> RESOLVED -> CLOSED, or OPEN ->
// CANCELLED. No REOPENED value here - Phase 9 does not implement a
// reopen operation (spec: "only implement this if the workflow requires
// it" - it doesn't yet); ComplaintActivityType keeps a REOPENED value
// ready for when it does, since recording that it *could* happen is
// cheap but adding the actual state later would be a data migration.
// Every transition is decided by ComplaintLifecycleService, never a
// client-supplied status field (spec: "do NOT use unrestricted PATCH for
// lifecycle state") - the same "action-based, not generic PATCH"
// principle every lifecycle in this codebase already uses.
enum ComplaintStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
  CANCELLED
}

// A permanent, append-only record of what happened to a complaint - the
// server creates these as a side effect of real operations; there is no
// endpoint that accepts a client-submitted activity record (the same
// principle as Phase 8's AuditLog).
enum ComplaintActivityType {
  CREATED
  ASSIGNED
  UNASSIGNED
  STATUS_CHANGED
  PRIORITY_CHANGED
  COMMENT_ADDED
  RESOLVED
  CLOSED
  CANCELLED
  REOPENED
}

// PUBLIC - visible to the tenant, the assignee, and any
// OWNER/MANAGER/STAFF of the organization. INTERNAL - visible only to
// OWNER/MANAGER/STAFF (and SUPER_ADMIN) - a tenant must never see an
// INTERNAL comment (spec: "tenant must never see INTERNAL comments").
// Enforced by ComplaintsService's response-shaping, never left to the
// client to filter.
enum ComplaintCommentVisibility {
  PUBLIC
  INTERNAL
}

// ---------------------------------------------------------------------------
// Food / meals / menu (Phase 10)
//
// A third, deliberately separate financial domain (spec section 4): rent
// (Phase 5/6), SaaS (Phase 7), and now food - a food subscription payment
// must never become tenant rent volume or feed OwnerSettlement (spec
// section 46/47). Reuses `PaymentProvider`/`BillingCycle` (Phase 6/5)
// where the meaning is identical, but defines its own invoice/payment
// status enums - mirroring, never reusing, Phase 7's SaaS billing shape
// (see README's "Phase 10" section for why).
// ---------------------------------------------------------------------------

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
  OTHER
}

enum FoodPlanStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum FoodSubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

enum MenuStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum MealConsumptionSource {
  STAFF_MARKED
  TENANT_MARKED
  SYSTEM
}

// Deliberately a narrower lifecycle than Phase 5's InvoiceStatus (no
// PARTIALLY_PAID) - a food subscription invoice is always paid in full by
// exactly one successful FoodSubscriptionPayment, never partially.
enum FoodSubscriptionInvoiceStatus {
  DRAFT
  ISSUED
  OVERDUE
  PAID
  VOID
}

enum FoodSubscriptionPaymentStatus {
  CREATED
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED
  REFUNDED
}

// ---------------------------------------------------------------------------
// Owner SaaS subscription (Phase 7)
//
// A completely separate financial domain from Phase 6: the PG *owner*
// pays *this platform* for the right to use it, as opposed to a *tenant*
// paying an *owner* rent (Phase 6). No model here is ever reused for a
// tenant rent payment, and no Phase 6 model is reused here - see
// README's "Phase 7" section for the full "two separate money flows"
// reasoning.
// ---------------------------------------------------------------------------

// ACTIVE plans are offered to organizations; INACTIVE plans are retired
// (never deleted - existing subscriptions/invoices still reference them).
enum SaasPlanStatus {
  ACTIVE
  INACTIVE
}

// Deliberately just MONTHLY for Phase 7 - see BillingCycle (Phase 5) for
// the same "one value now, extensible enum" reasoning.
enum SaasBillingInterval {
  MONTHLY
}

// TRIAL -> ACTIVE -> RENEWAL_DUE -> GRACE_PERIOD -> SUSPENDED is the
// normal unpaid-lapse path; a successful payment from RENEWAL_DUE,
// GRACE_PERIOD, or SUSPENDED all return to ACTIVE. CANCELLED is reachable
// only from ACTIVE/TRIAL (via the explicit cancel-at-period-end action)
// and is terminal. All transitions are decided by
// SubscriptionsService.evaluateLifecycle / explicit action methods, never
// a client-supplied status field - see SubscriptionsService docs.
enum SubscriptionStatus {
  TRIAL
  ACTIVE
  RENEWAL_DUE
  GRACE_PERIOD
  SUSPENDED
  CANCELLED
}

// Mirrors Phase 5's InvoiceStatus shape deliberately (DRAFT/ISSUED/
// OVERDUE/VOID) plus PAID, but is its own enum on its own model -
// SubscriptionInvoice is never stored in the Invoice table, since an
// owner's SaaS bill and a tenant's rent bill are different domains that
// happen to share a similar lifecycle shape.
enum SubscriptionInvoiceStatus {
  DRAFT
  ISSUED
  OVERDUE
  PAID
  VOID
}

// Same shape as Phase 6's PaymentStatus, deliberately without
// REFUNDED/PARTIALLY_REFUNDED distinctions beyond REFUNDED - SaaS refunds
// are out of scope for Phase 7 (see SubscriptionPayment's doc comment).
enum SubscriptionPaymentStatus {
  CREATED
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED
  REFUNDED
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

// Represents a person's identity, independent of any organization or role.
// Authorization (what a user can do, in which organization) lives entirely
// in OrganizationMembership - never add a global "role" field here.
model User {
  id           String       @id @default(uuid())
  phone        String?      @unique
  email        String?      @unique
  name         String
  passwordHash String?
  platformRole PlatformRole @default(USER)
  status       UserStatus   @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships             OrganizationMembership[]
  refreshTokens           RefreshToken[]
  tenant                  Tenant?
  identityVerifications   IdentityVerification[]
  payments                Payment[]
  auditLogs               AuditLog[]
  reportedComplaints      Complaint[]              @relation("ComplaintReporter")
  assignedComplaints      Complaint[]              @relation("ComplaintAssignee")
  complaintActivities     ComplaintActivity[]
  complaintComments       ComplaintComment[]
  complaintAttachments    ComplaintAttachment[]
  mealConsumptionsMarked  MealConsumption[]        @relation("MealConsumptionMarkedBy")
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  pushDevices             PushDevice[]

  applicationsSubmitted   ApplicationActivity[]
  applicationsAsApplicant TenantApplication[]   @relation("ApplicationApplicant")
  applicationsReviewed    TenantApplication[]   @relation("ApplicationReviewer")
  visitsAsApplicant       PropertyVisit[]       @relation("VisitApplicant")
  visitsCreated           PropertyVisit[]       @relation("VisitCreatedBy")

  @@map("users")
}

// Opaque refresh token record - one row per issued refresh token, i.e. one
// row per active login session/device. We never store the raw token, only
// a SHA-256 hash of it, so a leaked database dump cannot be used to forge
// sessions. Storing tokens (rather than trusting the JWT alone) is what
// makes revocation and "logout everywhere" possible.
//
// Rotation: each refresh call revokes the presented row (revokedAt set) and
// creates a brand new row for the replacement token - a row is never
// updated back to "unrevoked". Presenting an already-revoked token is
// treated as reuse (see AuthService.refresh); there is no explicit "session
// family" column, so reuse detection revokes every other still-active row
// for the same userId, which is a simpler, equally effective grouping given
// Phase 1 has no other concept a family could hang off.
model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  // Set once, when the row is created from a rotation. Distinct from
  // `createdAt` only in intent (last time this exact token was *presented
  // and accepted*, useful for "this device was active on ..." UI later).
  lastUsedAt DateTime?
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// Identity/KYC verification is deliberately its own domain, separate from
// both authentication (proving access to an account) and residency (proving
// someone actually lives somewhere). Authenticating does not imply verified
// identity; being verified does not imply being a tenant anywhere.
//
// `provider`/`providerReference` are the seam for a future external KYC
// vendor integration (DigiLocker, an Aadhaar-eKYC provider, etc.) - this
// table stores the *result* of verification, never raw government ID
// numbers or document images. If document storage is ever needed, it
// belongs in encrypted object storage referenced by `providerReference`,
// not as a column here.
//
// One user can hold multiple rows (one per verificationType, and a new row
// each time a check is retried/re-verified) - never a single mutable
// "verified: boolean" on User, which could not represent "verified for ID
// but not yet for address" or preserve history of a failed then later
// successful attempt.
model IdentityVerification {
  id                String                     @id @default(uuid())
  userId            String
  user              User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  verificationType  IdentityVerificationType
  provider          String?
  status            IdentityVerificationStatus @default(NOT_STARTED)
  providerReference String?
  verifiedAt        DateTime?
  expiresAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, verificationType])
  @@map("identity_verifications")
}

// ---------------------------------------------------------------------------
// Multi-tenancy
// ---------------------------------------------------------------------------

// The billable SaaS tenant. Owns one or more Properties. All business data
// (properties, rooms, beds, tenants, ...) is scoped to an Organization.
model Organization {
  id     String             @id @default(uuid())
  name   String
  status OrganizationStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships    OrganizationMembership[]
  properties     Property[]
  payments       Payment[]
  settlements    OwnerSettlement[]
  paymentAccount OwnerPaymentAccount?

  subscription         OrganizationSubscription?
  subscriptionInvoices SubscriptionInvoice[]
  subscriptionPayments SubscriptionPayment[]
  complaints           Complaint[]

  foodConfigurations       FoodConfiguration[]
  foodPlans                FoodPlan[]
  foodSubscriptions        TenantFoodSubscription[]
  foodSubscriptionInvoices FoodSubscriptionInvoice[]
  foodSubscriptionPayments FoodSubscriptionPayment[]
  menus                    Menu[]
  mealConsumptions         MealConsumption[]
  notifications            Notification[]

  propertyListings   PropertyListing[]
  tenantApplications TenantApplication[]
  propertyVisits     PropertyVisit[]

  @@map("organizations")
}

// Join model between User and Organization carrying the role. A single user
// can hold different roles in different organizations (e.g. OWNER of one PG
// business, STAFF in another), and a single organization has many members.
model OrganizationMembership {
  id             String           @id @default(uuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           MembershipRole
  status         MembershipStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A user has exactly one membership (one role) per organization - the
  // database enforces this, not just an application-level pre-check, so
  // two concurrent "create organization"/"join organization" requests for
  // the same user+org can never race into duplicate rows.
  //
  // No separate @@index([userId]): a composite index on (userId,
  // organizationId) already serves "find all memberships for this user"
  // queries via its leftmost column, so a second index would just be
  // redundant write overhead for no read benefit.
  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("organization_memberships")
}

// ---------------------------------------------------------------------------
// Property / Room / Bed
// ---------------------------------------------------------------------------

model Property {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  propertyType   PropertyType   @default(PG)
  addressLine1   String
  addressLine2   String?
  city           String
  state          String
  postalCode     String
  status         PropertyStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rooms       Room[]
  residencies Residency[]
  payments    Payment[]
  complaints  Complaint[]

  listing      PropertyListing?
  applications TenantApplication[]
  visits       PropertyVisit[]

  foodConfiguration        FoodConfiguration?
  foodPlans                FoodPlan[]
  foodSubscriptions        TenantFoodSubscription[]
  foodSubscriptionInvoices FoodSubscriptionInvoice[]
  foodSubscriptionPayments FoodSubscriptionPayment[]
  menus                    Menu[]
  mealConsumptions         MealConsumption[]
  notifications            Notification[]

  @@index([organizationId])
  // Every tenant-scoped "list my properties" / "is this property archived"
  // query filters by both columns together - see PropertiesService.
  @@index([organizationId, status])
  @@map("properties")
}

// roomNumber is a string, not an int - real-world numbering ("G01",
// "A-101", "DORM-1") is never purely numeric, and treating it as one would
// force awkward client-side formatting for something that is really just a
// label. Only unique per property (see @@unique below), never globally -
// "Room 101" existing in two different properties is normal, not a
// collision.
model Room {
  id         String     @id @default(uuid())
  propertyId String
  property   Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomNumber String
  floor      Int?
  roomType   RoomType
  // Maximum number of beds this room may hold - enforced in
  // RoomsService/BedsService via a locked read-count-then-write
  // transaction (SELECT ... FOR UPDATE on this row), not by a CHECK
  // constraint - Postgres cannot express "count of a *different* table's
  // rows" in a column constraint. See RoomsService docs for the exact
  // concurrency strategy.
  capacity   Int
  status     RoomStatus @default(ACTIVE)

  // Phase 13 room details. pricePerBed is the *advertised* monthly rate per
  // bed - informational for owners and search; what a tenant actually pays
  // is still their own RentPlan (never derived from this). imageUrl is an
  // externally hosted http(s) image; there is no file-upload service yet.
  pricePerBed Decimal?      @db.Decimal(12, 2)
  currency    String        @default("INR")
  amenities   RoomAmenity[] @default([])
  imageUrl    String?
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  beds       Bed[]
  complaints Complaint[]

  @@unique([propertyId, roomNumber])
  @@index([propertyId])
  @@index([propertyId, status])
  @@map("rooms")
}

// bedNumber is a string for the same reason as Room.roomNumber ("B1", "1",
// "BED-A" are all valid) and is unique only per room, never globally.
model Bed {
  id        String    @id @default(uuid())
  roomId    String
  room      Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  bedNumber String
  status    BedStatus @default(AVAILABLE)
  berth     BedBerth?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations BedAllocation[]
  complaints  Complaint[]

  @@unique([roomId, bedNumber])
  @@index([roomId])
  @@index([roomId, status])
  @@map("beds")
}

// ---------------------------------------------------------------------------
// Tenants, residency & bed allocation (Phase 4)
//
// Phase 0 originally scaffolded Tenant as an organization-scoped guest
// record (name/phone/email/status, optional userId) and BedAllocation as a
// direct Tenant<->Bed link. Phase 4 replaces that shape - both tables were
// still empty (never built on by any service through Phase 3) - with the
// architecture the product actually needs: a tenant is a thin, global,
// 1:1 domain profile on top of User (never a duplicate identity), and
// occupancy is tracked as history through an explicit Residency, not a
// direct Tenant<->Bed pointer. See README's "Phase 4" section for the full
// User -> Tenant -> Residency -> BedAllocation -> Bed chain and why each
// layer exists separately.
// ---------------------------------------------------------------------------

// The minimal domain marker that a User is (or has been) a resident
// somewhere, distinct from authentication (Phase 1) and from
// identity/KYC verification (also Phase 1) - a User can log in and even be
// KYC-verified without ever becoming a Tenant. `userId` is unique and
// required: Phase 4 has no "offline tenant with no login" flow (that
// would be a future guest/visit-booking concern), so every Tenant maps to
// exactly one existing platform User, never a second identity record.
//
// Deliberately has no name/phone/email/status columns - those either
// duplicate User (name/phone/email) or belong on Residency, not on the
// tenant identity itself (status: whether *this particular stay* is
// active is a Residency concern; a person is not "CHECKED_OUT" as a
// person, only a specific residency is).
model Tenant {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  residencies Residency[]
  complaints  Complaint[]

  foodSubscriptions        TenantFoodSubscription[]
  foodSubscriptionInvoices FoodSubscriptionInvoice[]
  foodSubscriptionPayments FoodSubscriptionPayment[]
  mealConsumptions         MealConsumption[]

  @@map("tenants")
}

// "Tenant X is/was staying at Property Y during this period." Deliberately
// does NOT mean application, booking, payment, rent, or KYC - those are
// separate domains (some not yet built). A tenant can accumulate many
// Residency rows over time (one per stay, at the same or different
// properties); history is never overwritten.
//
// Created in PENDING - a residency is scheduled before anyone is
// necessarily assigned a bed. Check-in (ResidenciesService.checkIn) is
// what allocates a bed (via BedAllocation) and moves status to ACTIVE;
// check-out moves it to CHECKED_OUT. See ResidencyStatus for the full
// transition table.
//
// `startDate` is the intended/agreed move-in date, set at creation and not
// changed by check-in. `actualEndDate` is set only by check-out, and only
// a CHECKED_OUT residency may have one (see ResidenciesService validation).
//
// One-active-residency-per-tenant is enforced by a partial unique index
// added by hand in this phase's migration SQL (Prisma's schema DSL cannot
// express a WHERE clause on a unique index):
//   CREATE UNIQUE INDEX residencies_active_tenant_unique
//     ON residencies (tenant_id) WHERE status = 'ACTIVE';
// This is the database-level backstop for "a tenant should not be
// ACTIVE at two properties simultaneously" - the application also checks
// this at residency-creation time, but the index is what actually
// guarantees it under concurrent check-ins (see ResidenciesService.checkIn).
model Residency {
  id              String          @id @default(uuid())
  tenantId        String
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId      String
  property        Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  startDate       DateTime
  expectedEndDate DateTime?
  actualEndDate   DateTime?
  status          ResidencyStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations BedAllocation[]
  rentPlans   RentPlan[]
  invoices    Invoice[]
  payments    Payment[]
  complaints  Complaint[]

  foodSubscriptions        TenantFoodSubscription[]
  foodSubscriptionInvoices FoodSubscriptionInvoice[]
  foodSubscriptionPayments FoodSubscriptionPayment[]
  mealConsumptions         MealConsumption[]

  @@index([tenantId])
  @@index([propertyId])
  @@index([propertyId, status])
  @@map("residencies")
}

// Full history of which residency occupied which bed and when. This is the
// layer that makes bed transfers possible without destroying history: a
// residency can hold multiple BedAllocation rows over time (Bed A, Jan-Mar;
// Bed B, Mar-Jun), never a single mutable `Residency.bedId` pointer. We
// never overwrite this record - ending an allocation sets `endDate`/status,
// it never deletes the row.
//
// Concurrency safety: a second partial unique index is added by hand in
// this phase's migration SQL alongside the one on `residencies` above:
//   CREATE UNIQUE INDEX bed_allocations_active_bed_unique
//     ON bed_allocations (bed_id) WHERE status = 'ACTIVE';
// This guarantees, at the database level, that a bed can have at most one
// active occupant even under concurrent check-in requests to the same bed -
// see ResidenciesService.checkIn for how a resulting unique-violation is
// translated into a safe BED_ALREADY_OCCUPIED response rather than a raw
// database error. Check-in/checkout are additionally wrapped in a single
// Prisma transaction so a partial write (e.g. ending the old allocation but
// failing to create the new one) can never be persisted.
model BedAllocation {
  id          String              @id @default(uuid())
  residencyId String
  residency   Residency           @relation(fields: [residencyId], references: [id], onDelete: Cascade)
  bedId       String
  bed         Bed                 @relation(fields: [bedId], references: [id], onDelete: Cascade)
  startDate   DateTime
  endDate     DateTime?
  status      BedAllocationStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([residencyId])
  @@index([bedId])
  @@map("bed_allocations")
}

// ---------------------------------------------------------------------------
// Rent & invoices (Phase 5)
//
// The financial obligation layer. An Invoice is generated *because of* a
// Residency, but a Residency is never itself the invoice, and a RentPlan is
// never the source of truth for what a past invoice actually charged -
// each of these is a deliberately separate concept:
//   Residency  - "this tenant is/was staying here" (Phase 4, unchanged)
//   RentPlan   - "this is the agreed rent rate, effective from ... to ..."
//   Invoice    - "this is what was actually billed for one period" (a
//                permanent, immutable-once-issued financial snapshot)
//   InvoiceItem - one billed line within an invoice (only RENT this phase)
// See README's "Phase 5" section for the full chain and the reasoning
// behind each boundary.
//
// Money: every monetary column is `Decimal @db.Decimal(12, 2)` - never a
// JS floating-point number - to avoid the rounding drift floats introduce
// in financial arithmetic. Precision 12 (up to 9,999,999,999.99),
// scale 2, rounding mode ROUND_HALF_UP wherever the application rounds
// (see ProrationService). Currency is a plain string, defaulted to "INR"
// and stored per-row (not a global constant) specifically so a future
// multi-currency change is a new value written per invoice, not a schema
// migration - Phase 5 itself only ever writes "INR".
// ---------------------------------------------------------------------------

// One row per agreed rent rate for a residency. Changing a resident's rent
// NEVER mutates this row's `amount` - see spec section 8: history must
// stay intact. Instead, RentPlansService.create closes out the current
// ACTIVE plan (`effectiveTo` set, `status: INACTIVE`) and inserts a new
// ACTIVE row in the same transaction. `amount`/`dueDay`/`effectiveFrom` are
// therefore immutable after creation; PATCH /rent-plans/:id only ever
// touches `dueDay` (a correction) or performs the one controlled
// ACTIVE -> INACTIVE transition (ending a plan without a replacement) -
// never a generic status field a client could set to anything.
//
// `effectiveFrom`/`effectiveTo` form a half-open interval
// [effectiveFrom, effectiveTo) - `effectiveTo: null` means "still in
// effect". Exactly one ACTIVE plan may exist per residency, enforced by a
// partial unique index added by hand in this phase's migration SQL
// (Prisma's schema DSL cannot express a WHERE clause on a unique index -
// same limitation already documented for Residency/BedAllocation):
//   CREATE UNIQUE INDEX rent_plans_active_residency_unique
//     ON rent_plans ("residencyId") WHERE status = 'ACTIVE';
model RentPlan {
  id            String         @id @default(uuid())
  residencyId   String
  residency     Residency      @relation(fields: [residencyId], references: [id], onDelete: Cascade)
  amount        Decimal        @db.Decimal(12, 2)
  currency      String         @default("INR")
  billingCycle  BillingCycle   @default(MONTHLY)
  // Day of the month rent is due (1-31). A month without that day (e.g.
  // dueDay=31 in February) deterministically falls back to that month's
  // last day - see InvoicesService.computeDueDate.
  dueDay        Int
  effectiveFrom DateTime
  effectiveTo   DateTime?
  status        RentPlanStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices Invoice[]

  @@index([residencyId])
  @@index([residencyId, status])
  @@map("rent_plans")
}

// A permanent financial record - "how much this resident owed for this
// billing period" - never recalculated from the current RentPlan (spec
// section 11: `subtotal`/`discount`/`tax`/`total` are the actual snapshot
// values used at generation time, even if `rentPlan.amount` changes
// afterward). `rentPlanId` is kept only for audit traceability ("which
// plan produced this") and is nullable with `onDelete: SetNull` - it is
// never read back to reconstruct a total.
//
// `invoiceNumber` is the human-facing identifier (e.g. "INV-2027-000001"),
// generated from a Postgres sequence (`invoice_number_seq`, created by
// hand in this phase's migration SQL) - never `COUNT(*) + 1`, which races
// under concurrent generation. See InvoicesService.generateInvoiceNumber.
//
// `status` lifecycle: DRAFT -> ISSUED -> OVERDUE (lazily, on read, past
// dueDate) -> (any of DRAFT/ISSUED/OVERDUE) -> VOID. VOID is terminal -
// spec section 17/23 explicitly do not support re-issuing a voided
// invoice; a correction is a new invoice, not a resurrected one.
//
// One rent invoice per residency per billing period is enforced by a
// plain (non-partial) unique constraint, since Prisma's schema DSL can
// express this one directly - no hand-written SQL needed here.
model Invoice {
  id                 String        @id @default(uuid())
  residencyId        String
  residency          Residency     @relation(fields: [residencyId], references: [id], onDelete: Cascade)
  rentPlanId         String?
  rentPlan           RentPlan?     @relation(fields: [rentPlanId], references: [id], onDelete: SetNull)
  invoiceNumber      String        @unique
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  issueDate          DateTime?
  dueDate            DateTime
  subtotal           Decimal       @db.Decimal(12, 2)
  discount           Decimal       @default(0) @db.Decimal(12, 2)
  tax                Decimal       @default(0) @db.Decimal(12, 2)
  total              Decimal       @db.Decimal(12, 2)
  currency           String        @default("INR")
  status             InvoiceStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items       InvoiceItem[]
  payments    Payment[]
  allocations PaymentAllocation[]

  // "One rent invoice per residency per billing period" (spec section 13).
  // Named explicitly rather than relying on Prisma's auto-generated name,
  // since the application catches a P2002 on this exact constraint by
  // name to translate it into DUPLICATE_BILLING_PERIOD - see
  // InvoicesService.generateForResidency.
  @@unique([residencyId, billingPeriodStart, billingPeriodEnd], name: "invoices_residency_billing_period_unique")
  @@index([residencyId, status])
  @@index([dueDate, status])
  @@map("invoices")
}

// One billed line within an invoice. `amount` is always the authoritative
// snapshot value (`quantity * unitAmount`, computed server-side) - the
// server calculates every financial field; a client never supplies
// subtotal/tax/total or a line amount directly (spec section 35).
model InvoiceItem {
  id          String          @id @default(uuid())
  invoiceId   String
  invoice     Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  itemType    InvoiceItemType @default(RENT)
  quantity    Int             @default(1)
  unitAmount  Decimal         @db.Decimal(12, 2)
  amount      Decimal         @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@map("invoice_items")
}

// ---------------------------------------------------------------------------
// Tenant payments, platform fee & owner settlement (Phase 6)
//
// Two separate money flows exist in this business, and this section models
// only one of them - a tenant paying PG rent:
//   Tenant --[Payment: gross amount]--> Platform --[fee retained]-->
//     PG Owner (the remainder, via OwnerSettlement)
// The other flow - an owner paying this platform a SaaS subscription - is
// a completely separate future domain (Phase 7) and shares no model with
// this section on purpose (see README's "Phase 6" section).
//
// Chain: Residency -> Invoice (Phase 5, unchanged) -> Payment (an attempt/
// transaction to pay that invoice) -> PaymentAllocation (how much of that
// payment actually counted toward the invoice's balance) -> OwnerSettlement
// (the owner's share of a captured payment, tracked separately - "the
// tenant paid" and "the owner was paid out" are different facts, see
// OwnerSettlement's own doc comment).
// ---------------------------------------------------------------------------

// One payment attempt/transaction against exactly one Invoice. `amount` is
// always the gross amount the tenant is charged (spec section 17 - the
// platform fee is never subtracted from this field); `platformFee` and
// `ownerSettlementAmount` are recorded alongside it as an explicit
// breakdown, not derived on read, so the historical record survives a
// later change to the platform's fee rule. Both are server-calculated at
// order-creation time - a client never supplies them (spec section 28).
//
// A Payment only ever becomes a PaymentAllocation (i.e. counts toward the
// invoice's paid balance) once `status` reaches CAPTURED - see
// PaymentsService.finalizeCapturedPayment. `organizationId`/`propertyId`/
// `residencyId` are denormalized from the invoice at creation time (never
// re-derived from a possibly-different current invoice state later) so a
// payment can never be queried into the wrong PG in a multi-PG
// organization (spec sections 23-24), and so a payment's own organization
// scope survives even if the invoice were ever reassigned (it is not, but
// the columns make that assumption explicit rather than implicit).
model Payment {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId     String
  property       Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  residencyId    String
  residency      Residency    @relation(fields: [residencyId], references: [id], onDelete: Cascade)
  invoiceId      String
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  payerUserId    String
  payerUser      User         @relation(fields: [payerUserId], references: [id], onDelete: Cascade)

  amount                Decimal @db.Decimal(12, 2)
  currency              String  @default("INR")
  platformFee           Decimal @default(0) @db.Decimal(12, 2)
  ownerSettlementAmount Decimal @default(0) @db.Decimal(12, 2)

  // Populated from the gateway once known (e.g. "card", "upi",
  // "netbanking") - never client-supplied at order-creation time.
  method   String?
  status   PaymentStatus   @default(CREATED)
  provider PaymentProvider @default(RAZORPAY)

  // Unique "where applicable" (spec section 38) - null until the gateway
  // assigns one, which is exactly when it must be unique.
  providerOrderId   String? @unique
  providerPaymentId String? @unique

  // Client-supplied `Idempotency-Key` header (spec section 34), stored so
  // a retried order-creation request (network timeout, app restart) can be
  // recognized and answered with the original Payment instead of creating
  // a second one. Null for callers that don't send the header - not
  // enforced as the only idempotency mechanism (see PaymentsService).
  idempotencyKey String? @unique

  failureCode    String?
  failureMessage String?
  paidAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations PaymentAllocation[]
  settlement  OwnerSettlement?
  refunds     Refund[]

  @@index([organizationId])
  @@index([propertyId])
  @@index([residencyId])
  @@index([invoiceId])
  @@index([payerUserId])
  @@map("payments")
}

// How much of a given Payment actually counts toward a given Invoice's
// paid balance - kept as its own table (never a column on Payment) so an
// invoice's outstanding balance is always computed the same deterministic
// way regardless of how many payments have been attempted against it:
// `Invoice.total - SUM(PaymentAllocation.amount for CAPTURED payments)`
// (see PaymentsService.getOutstandingBalance). A failed/cancelled payment
// never gets an allocation row; a refund does not delete one (deleting
// history is never how this project represents a reversal - see
// BedAllocation/RentPlan for the same principle applied elsewhere) but
// instead the owning Payment's status moves to REFUNDED/
// PARTIALLY_REFUNDED and PaymentsService excludes refunded amounts from
// the balance calculation from that point on.
//
// `@@unique([paymentId, invoiceId])` prevents a duplicate allocation for
// the same payment/invoice pair (spec section 38) - relevant because
// webhook processing is idempotent and must never double-allocate a
// payment it has already finalized.
model PaymentAllocation {
  id        String  @id @default(uuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@unique([paymentId, invoiceId], name: "payment_allocations_payment_invoice_unique")
  @@index([invoiceId])
  @@map("payment_allocations")
}

// The platform's fee rule, deliberately just FIXED for Phase 6 (spec
// section 19-20). PlatformFeeService reads the single currently-active
// row (`isActive: true`, most recently created) rather than any code
// ever hardcoding an amount - so the business rule can change later by
// inserting a new row (and deactivating the old one), never a
// deployment. Historical Payments are unaffected by a later change here
// because `Payment.platformFee` is a snapshot, not a live lookup (see
// Payment's own doc comment).
model PlatformFeeRule {
  id       String          @id @default(uuid())
  feeType  PlatformFeeType @default(FIXED)
  // For feeType FIXED: the flat fee amount charged per successful payment
  // (e.g. "1.00"). No percentage field exists yet - see PlatformFeeType.
  amount   Decimal         @db.Decimal(12, 2)
  isActive Boolean         @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("platform_fee_rules")
}

// Where a PG owner's settled funds actually go - the gateway's own
// account/onboarding construct (e.g. a Razorpay Route "linked account"),
// never raw bank/card details (spec section 22). Scoped to
// `organizationId` (one per organization, `@@unique`) rather than per
// property: spec section 24 explicitly asks for "one organization -> one
// settlement account -> multiple properties" as the Phase 6 default,
// without hardcoding "one property = one owner account" - scoping this
// at the organization level (not adding a propertyId at all) is what
// keeps a future per-property override possible as a schema addition
// later, never a required rewrite of this table.
model OwnerPaymentAccount {
  id                String                    @id @default(uuid())
  organizationId    String                    @unique
  organization      Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider          PaymentProvider           @default(RAZORPAY)
  providerAccountId String                    @unique
  status            OwnerPaymentAccountStatus @default(PENDING)
  onboardingStatus  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settlements OwnerSettlement[]

  @@map("owner_payment_accounts")
}

// "The owner's share of a captured payment was transferred" - a
// deliberately separate fact from "the tenant successfully paid"
// (Payment.status = CAPTURED). Spec section 36 is explicit that these
// must never be confused: a Payment can be CAPTURED while its
// OwnerSettlement is still PENDING/PROCESSING, and a settlement can FAIL
// without that ever changing the tenant-facing Payment status - the
// tenant already paid; a delayed or failed payout is purely a
// platform/owner-side operational concern. `@@unique` on `paymentId`
// prevents the same captured payment from ever producing two settlement
// records (spec sections 38/44). `providerTransferId` is unique "where
// present" (null until the gateway confirms a transfer).
model OwnerSettlement {
  id                    String               @id @default(uuid())
  paymentId             String               @unique
  payment               Payment              @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  organizationId        String
  organization          Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownerPaymentAccountId String?
  ownerPaymentAccount   OwnerPaymentAccount? @relation(fields: [ownerPaymentAccountId], references: [id], onDelete: SetNull)

  grossAmount      Decimal @db.Decimal(12, 2)
  platformFee      Decimal @db.Decimal(12, 2)
  settlementAmount Decimal @db.Decimal(12, 2)
  currency         String  @default("INR")

  providerTransferId String?          @unique
  status             SettlementStatus @default(PENDING)
  settledAt          DateTime?
  failureReason      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
  @@map("owner_settlements")
}

// A tenant-initiated refund against a previously CAPTURED payment (spec
// section 37). Deliberately its own table, never a mutation of Payment's
// own amount field - a refund is a new financial event, not an edit to
// history. `amount` may be less than the original `Payment.amount`
// (partial refund). If the underlying payment's OwnerSettlement had
// already reached PROCESSING/SETTLED, PaymentsService marks that
// settlement REVERSED as an accounting flag - actually recovering funds
// already paid out to the owner is a gateway-specific capability (e.g. a
// reversal/deduction on the owner's linked account) that Phase 6 does not
// invent or assume; see README's "Phase 6" section and the Final Report's
// "known limitations" for what is and isn't handled here.
model Refund {
  id               String       @id @default(uuid())
  paymentId        String
  payment          Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amount           Decimal      @db.Decimal(12, 2)
  reason           String?
  status           RefundStatus @default(PENDING)
  providerRefundId String?      @unique
  failureReason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentId])
  @@map("refunds")
}

// Every inbound gateway webhook call, persisted before any business logic
// runs. `@@unique([provider, eventId])` is what actually makes webhook
// processing idempotent under a genuine duplicate delivery (spec sections
// 31-33) - a repeated webhook's insert raises a unique violation, caught
// and treated as "already processed, acknowledge and no-op" rather than
// re-running any financial side effect. `payload` retains the full
// verified body for later reconciliation/debugging (spec section 40) -
// never re-fetched from the gateway after the fact.
model WebhookEvent {
  id          String          @id @default(uuid())
  provider    WebhookProvider @default(RAZORPAY)
  eventId     String
  eventType   String
  payload     Json
  processedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([provider, eventId], name: "webhook_events_provider_event_unique")
  @@map("webhook_events")
}

// ---------------------------------------------------------------------------
// Owner SaaS subscription (Phase 7)
//
// Chain: Organization -> OrganizationSubscription -> SubscriptionInvoice ->
// SubscriptionPayment. Deliberately organization-scoped, never per-property
// (spec section: "one owner -> one organization-level subscription, unless
// a future plan explicitly introduces property-based pricing") - an
// OrganizationSubscription has no propertyId column at all, so per-property
// billing is a schema addition later, not a redesign.
//
// Webhook processing (payment.captured) is dispatched from the same
// PaymentsWebhookService/WebhookEvent table Phase 6 already built - see
// PaymentsWebhookService for how it distinguishes a tenant-rent Payment
// from a SubscriptionPayment by providerOrderId. There is exactly one
// (provider, eventId) idempotency table for both domains, because Razorpay
// itself only has one webhook delivery stream per merchant account.
// ---------------------------------------------------------------------------

// A billable tier the platform offers to organizations. Price changes
// never mutate a plan row in place in a way that could alter historical
// billing - see SubscriptionInvoice's doc comment for why a plan's
// *current* price and a *historical invoice's* amount are deliberately
// different values (the invoice snapshots it). `effectiveFrom`/
// `effectiveTo` exist for the same reason RentPlan (Phase 5) has them -
// if a plan's price genuinely changes, a new SaasPlan row is created and
// the old one's `effectiveTo`/`status: INACTIVE` are set, rather than
// editing `price` on the existing row.
model SaasPlan {
  id              String              @id @default(uuid())
  name            String
  description     String?
  price           Decimal             @db.Decimal(12, 2)
  currency        String              @default("INR")
  billingInterval SaasBillingInterval @default(MONTHLY)
  status          SaasPlanStatus      @default(ACTIVE)
  effectiveFrom   DateTime            @default(now())
  effectiveTo     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions OrganizationSubscription[]
  pendingFor    OrganizationSubscription[] @relation("PendingPlan")
  invoices      SubscriptionInvoice[]

  @@index([status])
  @@map("saas_plans")
}

// At most one subscription per organization (`@unique` on
// `organizationId`) - the organization can change plans over time, but
// always through this one row, never a second parallel subscription.
//
// `currentPeriodStart`/`currentPeriodEnd` describe the *last paid* (or
// trial) period - they are only extended by
// SubscriptionPaymentsService.finalizeCapturedPayment, never by invoice
// generation itself (see SubscriptionInvoice - a generated invoice
// describes a *prospective* next period that does not become "current"
// until it is actually paid). `nextBillingAt` mirrors `currentPeriodEnd`
// and exists as its own column so a future scheduled job
// (`SubscriptionLifecycleService.processDueSubscriptions`) can index and
// query on it directly without reasoning about period semantics.
//
// `pendingSaasPlanId` is Phase 7's plan-change mechanism (spec: "plan
// change takes effect at the next billing period") - set immediately by
// an owner's change-plan action, applied to `saasPlanId` (and cleared)
// only when the *next* invoice is generated, never retroactively - this
// is what keeps a plan change from ever altering an already-issued
// invoice's snapshot amount.
model OrganizationSubscription {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  saasPlanId     String
  saasPlan       SaasPlan     @relation(fields: [saasPlanId], references: [id], onDelete: Restrict)

  pendingSaasPlanId String?
  pendingSaasPlan   SaasPlan? @relation("PendingPlan", fields: [pendingSaasPlanId], references: [id], onDelete: SetNull)

  status             SubscriptionStatus @default(TRIAL)
  startedAt          DateTime           @default(now())
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  nextBillingAt      DateTime
  gracePeriodEndsAt  DateTime?
  cancelledAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices SubscriptionInvoice[]
  payments SubscriptionPayment[]

  @@index([status])
  @@index([nextBillingAt])
  @@map("organization_subscriptions")
}

// A permanent financial record - "how much this organization owed for
// this SaaS billing period" - snapshotted at generation time, exactly
// like Phase 5's Invoice: `subtotal`/`tax`/`total` never change after
// creation even if the referenced `SaasPlan.price` changes later.
// `saasPlanId` is kept for traceability, the same non-authoritative role
// `Invoice.rentPlanId` plays in Phase 5.
//
// `invoiceNumber` is generated from a dedicated Postgres sequence
// (`saas_invoice_number_seq`), never `COUNT(*) + 1` - same reasoning as
// Phase 5's `invoice_number_seq`.
//
// One invoice per subscription per billing period is enforced by a plain
// (non-partial) unique constraint, the same pattern Phase 5 uses for
// `invoices_residency_billing_period_unique`.
model SubscriptionInvoice {
  id             String                   @id @default(uuid())
  organizationId String
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription   OrganizationSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  saasPlanId     String
  saasPlan       SaasPlan                 @relation(fields: [saasPlanId], references: [id], onDelete: Restrict)

  invoiceNumber      String                    @unique
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  subtotal           Decimal                   @db.Decimal(12, 2)
  tax                Decimal                   @default(0) @db.Decimal(12, 2)
  total              Decimal                   @db.Decimal(12, 2)
  currency           String                    @default("INR")
  status             SubscriptionInvoiceStatus @default(ISSUED)
  issuedAt           DateTime?
  dueAt              DateTime
  paidAt             DateTime?
  voidedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments SubscriptionPayment[]

  // `map` gives the actual Postgres constraint this friendly name (Prisma's
  // `name:` alone only affects the generated Client API, not the database
  // object - see the Phase 6 lesson in README's "Phase 6" section about
  // P2002's `target` reporting column names rather than any given name
  // regardless of this, which is why the catch-block below still also
  // matches on column names, not just this string).
  @@unique([subscriptionId, billingPeriodStart, billingPeriodEnd], name: "subscription_invoices_period_unique", map: "subscription_invoices_period_unique")
  @@index([organizationId, status])
  @@index([dueAt, status])
  @@map("subscription_invoices")
}

// One payment attempt/transaction against exactly one SubscriptionInvoice
// - deliberately has no platform-fee or owner-settlement fields
// (unlike Phase 6's Payment): the organization is paying the platform
// directly, there is no third party to split funds with. `amount` is
// always `SubscriptionInvoice.total`, read from the database, never
// client-supplied (spec: "never accept the subscription price from the
// client").
//
// A single invoice may have multiple payment attempts (a failed one
// followed by a successful retry) - never assume the first is the only
// one; `finalizeCapturedPayment` is what actually marks the invoice PAID,
// and does so at most once per invoice (see its own docs for the
// concurrency guarantee).
model SubscriptionPayment {
  id                    String                   @id @default(uuid())
  organizationId        String
  organization          Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptionId        String
  subscription          OrganizationSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  subscriptionInvoiceId String
  subscriptionInvoice   SubscriptionInvoice      @relation(fields: [subscriptionInvoiceId], references: [id], onDelete: Cascade)

  amount   Decimal                   @db.Decimal(12, 2)
  currency String                    @default("INR")
  provider PaymentProvider           @default(RAZORPAY)
  status   SubscriptionPaymentStatus @default(CREATED)

  providerOrderId   String? @unique
  providerPaymentId String? @unique
  idempotencyKey    String? @unique

  failureCode    String?
  failureMessage String?
  capturedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([subscriptionId])
  @@index([subscriptionInvoiceId])
  @@map("subscription_payments")
}

// ---------------------------------------------------------------------------
// Platform admin (Phase 8)
//
// The Super Admin domain sits *above* every organization - it does not add
// a new organization-membership role (spec: "do NOT add SUPER_ADMIN to the
// existing organization membership role enum") and reuses
// `User.platformRole` (`PlatformRole.SUPER_ADMIN`), already present since
// Phase 1 for exactly this purpose. This section adds only what Phase 1-7
// genuinely lack: a durable record of sensitive platform-admin actions.
// ---------------------------------------------------------------------------

// One row per sensitive platform-admin action (spec: "audit Super Admin
// login, organization suspension/activation, plan creation/change/
// deactivation, manual subscription intervention"). `action` is a plain
// string, not an enum, deliberately - unlike a domain status field, the
// set of auditable actions grows independently of any state machine and
// a new one should never need a migration. `organizationId` is nullable
// because not every action is organization-scoped (e.g. a SaaS plan
// change affects no single organization). `metadata` never contains
// secrets/passwords/tokens - see AuditLogService's doc comment.
model AuditLog {
  id             String  @id @default(uuid())
  actorUserId    String
  actorUser      User    @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
  action         String
  entityType     String
  entityId       String
  organizationId String?
  metadata       Json?

  createdAt DateTime @default(now())

  @@index([actorUserId])
  @@index([organizationId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Complaints & maintenance (Phase 9)
//
// A tenant reports a problem with their room/bed/property; OWNER/MANAGER/
// STAFF triage, assign, and resolve it. Deliberately reuses every existing
// relationship instead of duplicating tenant/property/room context
// (spec: "do not create duplicate tenant/property/room models").
// ---------------------------------------------------------------------------

// `residencyId` (and, where known, `roomId`/`bedId`) are captured at
// creation time and never re-derived from the tenant's *current*
// residency later (spec: "a historical complaint must still point to the
// context in which it was created... do not make historical complaints
// dynamically resolve only from the tenant's current residency") - a
// tenant who moves from Room 101 to Room 203 keeps their old complaint
// pointing at Room 101. `tenantId` is denormalized alongside
// `residencyId` (never the sole source of truth - always cross-checked
// against the residency at creation) purely for query performance, the
// same denormalization Phase 6's `Payment` already does for its own
// organization/property/residency columns.
//
// `roomId`/`bedId` are nullable and `onDelete: SetNull` - a complaint
// about "the property in general" (spec: room/bed context is one of
// several - property, facilities, utilities, services) never requires
// either. `reportedByUserId` is `onDelete: Restrict` (a complaint must
// never lose who reported it); `assignedToUserId` is `onDelete: SetNull`
// (an assignee's account being removed should never destroy the
// complaint itself - see "Relation integrity" in README's "Phase 9"
// section for the full reasoning on every one of these choices).
model Complaint {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId     String
  property       Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  residencyId    String
  residency      Residency    @relation(fields: [residencyId], references: [id], onDelete: Cascade)
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roomId         String?
  room           Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull)
  bedId          String?
  bed            Bed?         @relation(fields: [bedId], references: [id], onDelete: SetNull)

  reportedByUserId String
  reportedByUser   User    @relation("ComplaintReporter", fields: [reportedByUserId], references: [id], onDelete: Restrict)
  assignedToUserId String?
  assignedToUser   User?   @relation("ComplaintAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  category    ComplaintCategory @default(OTHER)
  priority    ComplaintPriority @default(MEDIUM)
  status      ComplaintStatus   @default(OPEN)
  title       String
  description String

  resolutionNote String?
  resolvedAt     DateTime?
  closedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities  ComplaintActivity[]
  comments    ComplaintComment[]
  attachments ComplaintAttachment[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([propertyId])
  @@index([residencyId])
  @@index([tenantId, createdAt])
  @@index([assignedToUserId, status])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@map("complaints")
}

// Append-only activity trail - never updated or deleted (spec: "do not
// allow PATCH/DELETE on complaint activities"). Every lifecycle-relevant
// mutation in ComplaintLifecycleService writes exactly one row here in
// the same transaction as the mutation itself, so the trail can never
// drift from what actually happened. `old*`/`new*` columns are nullable
// because most activity types only ever populate one pair (e.g.
// `STATUS_CHANGED` sets `oldStatus`/`newStatus` and leaves the priority/
// assignee pairs null).
model ComplaintActivity {
  id          String                @id @default(uuid())
  complaintId String
  complaint   Complaint             @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  actorUserId String
  actorUser   User                  @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  type        ComplaintActivityType

  oldStatus     ComplaintStatus?
  newStatus     ComplaintStatus?
  oldPriority   ComplaintPriority?
  newPriority   ComplaintPriority?
  oldAssigneeId String?
  newAssigneeId String?
  comment       String?
  metadata      Json?

  createdAt DateTime @default(now())

  @@index([complaintId, createdAt])
  @@map("complaint_activities")
}

// PUBLIC/INTERNAL visibility is enforced entirely in
// ComplaintsService's read path (never trust a client to filter its own
// response) - see ComplaintCommentVisibility's own doc comment.
model ComplaintComment {
  id           String                     @id @default(uuid())
  complaintId  String
  complaint    Complaint                  @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  authorUserId String
  authorUser   User                       @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  body         String
  visibility   ComplaintCommentVisibility @default(PUBLIC)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([complaintId, createdAt])
  @@map("complaint_comments")
}

// A minimal reference model, deliberately never a file-storage platform
// (spec: "do NOT build a complicated file-storage platform unless one
// already exists" - this project has none). `url` points at wherever the
// client actually uploaded the file (out of scope for Phase 9); this
// table only registers that it exists, who uploaded it, and enough
// metadata (`mimeType`/`size`) for ComplaintAttachmentsService to
// validate it server-side before accepting the registration - see
// README's "Phase 9" section for the exact allowlist/size limit and why
// no upload endpoint exists here.
model ComplaintAttachment {
  id               String    @id @default(uuid())
  complaintId      String
  complaint        Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  uploadedByUserId String
  uploadedByUser   User      @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  url              String
  fileName         String
  mimeType         String
  size             Int

  createdAt DateTime @default(now())

  @@index([complaintId])
  @@map("complaint_attachments")
}

// ---------------------------------------------------------------------------
// Food / meals / menu (Phase 10)
// ---------------------------------------------------------------------------

// One row per property - "does this property do food at all, and how."
// `includedMealTypes` is only meaningful when `mealsIncludedInRent` is
// true; it is never re-derived from anywhere else (spec's Model A/B/C:
// a property can have meals included in rent, an optional paid
// subscription, both, or neither - see FoodEntitlementService for how
// these two independent facts combine into one entitlement view).
model FoodConfiguration {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId     String       @unique
  property       Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  enabled                     Boolean    @default(false)
  mealsIncludedInRent         Boolean    @default(false)
  includedMealTypes           MealType[] @default([])
  optionalSubscriptionEnabled Boolean    @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("food_configurations")
}

// A billable food tier offered at one property (spec: "food configuration
// belongs to a property," never organization-wide). `status` follows the
// same ACTIVE/INACTIVE/ARCHIVED shape as SaasPlan - only ACTIVE plans can
// be newly subscribed to; ARCHIVED plans are retired but never deleted
// because historical `TenantFoodSubscription`/`FoodSubscriptionInvoice`
// rows still reference them (spec section 13). `price` is the plan's
// *current* price - a subscribing tenant's own agreed price is snapshotted
// separately onto `TenantFoodSubscription.priceSnapshot` (see its own doc
// comment), the same "plan price changes, historical record doesn't"
// principle as Phase 5's RentPlan/Invoice and Phase 7's SaasPlan/
// SubscriptionInvoice.
model FoodPlan {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId     String
  property       Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  name         String
  description  String?
  status       FoodPlanStatus @default(ACTIVE)
  billingCycle BillingCycle   @default(MONTHLY)
  price        Decimal        @db.Decimal(12, 2)
  currency     String         @default("INR")
  mealTypes    MealType[]     @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions TenantFoodSubscription[]

  @@index([organizationId])
  @@index([propertyId, status])
  @@map("food_plans")
}

// One tenant's optional paid food subscription against one residency -
// deliberately separate from `FoodConfiguration.mealsIncludedInRent`
// (Model A never creates one of these rows at all, spec section 17).
// `priceSnapshot`/`currency` capture the plan's price *at subscribe time*
// (spec section 15) - never recalculated from `FoodPlan.price` later, the
// same historical-integrity rule as every other snapshot in this schema.
// `mealTypesSnapshot` similarly freezes which meals this subscription
// actually covers, so a later edit to `FoodPlan.mealTypes` cannot silently
// change what an existing subscriber is entitled to.
//
// At most one ACTIVE subscription per residency is enforced by a partial
// unique index added by hand in this phase's migration SQL (Prisma's
// schema DSL cannot express a WHERE clause on a unique index - the same
// limitation already documented for Residency/BedAllocation/RentPlan):
//   CREATE UNIQUE INDEX food_subscriptions_active_residency_unique
//     ON tenant_food_subscriptions ("residencyId") WHERE status = 'ACTIVE';
model TenantFoodSubscription {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId     String
  property       Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  residencyId    String
  residency      Residency    @relation(fields: [residencyId], references: [id], onDelete: Cascade)
  foodPlanId     String
  foodPlan       FoodPlan     @relation(fields: [foodPlanId], references: [id], onDelete: Restrict)

  status FoodSubscriptionStatus @default(ACTIVE)

  startDate DateTime
  endDate   DateTime?

  priceSnapshot     Decimal    @db.Decimal(12, 2)
  currency          String     @default("INR")
  mealTypesSnapshot MealType[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices FoodSubscriptionInvoice[]
  payments FoodSubscriptionPayment[]

  @@index([organizationId])
  @@index([propertyId])
  @@index([tenantId, createdAt])
  @@index([residencyId, status])
  @@map("tenant_food_subscriptions")
}

// A permanent financial record - "how much this subscription owed for
// this billing period" - snapshotted at generation time exactly like
// Phase 5's Invoice and Phase 7's SubscriptionInvoice; never recalculated
// from a later `FoodPlan.price`/`TenantFoodSubscription.priceSnapshot`
// change. `invoiceNumber` is generated from a dedicated Postgres sequence
// (`food_invoice_number_seq`, created by hand in this phase's migration
// SQL) - never `COUNT(*) + 1`.
//
// One invoice per subscription per billing period is enforced by a plain
// (non-partial) unique constraint, the same pattern as Phase 5/7's own
// billing-period uniqueness - given an explicit `map` so the actual
// Postgres constraint carries this name (Phase 6/7's own lesson: `name`
// alone never renames the database object, only the generated client API -
// see README's "Phase 6"/"Phase 7" sections).
model FoodSubscriptionInvoice {
  id                 String                 @id @default(uuid())
  organizationId     String
  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId         String
  property           Property               @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenantId           String
  tenant             Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  residencyId        String
  residency          Residency              @relation(fields: [residencyId], references: [id], onDelete: Cascade)
  foodSubscriptionId String
  foodSubscription   TenantFoodSubscription @relation(fields: [foodSubscriptionId], references: [id], onDelete: Cascade)

  invoiceNumber      String                        @unique
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  subtotal           Decimal                       @db.Decimal(12, 2)
  tax                Decimal                       @default(0) @db.Decimal(12, 2)
  total              Decimal                       @db.Decimal(12, 2)
  currency           String                        @default("INR")
  status             FoodSubscriptionInvoiceStatus @default(ISSUED)
  issuedAt           DateTime?
  dueAt              DateTime
  paidAt             DateTime?
  voidedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments FoodSubscriptionPayment[]

  @@unique([foodSubscriptionId, billingPeriodStart, billingPeriodEnd], name: "food_subscription_invoices_period_unique", map: "food_subscription_invoices_period_unique")
  @@index([organizationId, status])
  @@index([tenantId, createdAt])
  @@index([dueAt, status])
  @@map("food_subscription_invoices")
}

// One payment attempt/transaction against exactly one
// FoodSubscriptionInvoice - deliberately its own table, never Phase 6's
// `Payment` (spec section 5: "must NOT modify the existing Phase 6
// Payment model") and never creates a `PaymentAllocation`/
// `OwnerSettlement` (spec section 46) - there is no platform
// fee/owner-settlement split for food, the organization keeps 100% of
// what a tenant pays for food, same reasoning Phase 7's
// `SubscriptionPayment` already established for SaaS payments.
model FoodSubscriptionPayment {
  id                        String                  @id @default(uuid())
  organizationId            String
  organization              Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId                String
  property                  Property                @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenantId                  String
  tenant                    Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  residencyId               String
  residency                 Residency               @relation(fields: [residencyId], references: [id], onDelete: Cascade)
  foodSubscriptionId        String
  foodSubscription          TenantFoodSubscription  @relation(fields: [foodSubscriptionId], references: [id], onDelete: Cascade)
  foodSubscriptionInvoiceId String
  foodSubscriptionInvoice   FoodSubscriptionInvoice @relation(fields: [foodSubscriptionInvoiceId], references: [id], onDelete: Cascade)

  amount   Decimal                       @db.Decimal(12, 2)
  currency String                        @default("INR")
  provider PaymentProvider               @default(RAZORPAY)
  status   FoodSubscriptionPaymentStatus @default(CREATED)

  providerOrderId   String? @unique
  providerPaymentId String? @unique
  idempotencyKey    String? @unique

  failureCode    String?
  failureMessage String?
  capturedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([tenantId])
  @@index([foodSubscriptionInvoiceId])
  @@map("food_subscription_payments")
}

// A date-specific, immutable-once-past menu record - never a single
// mutable "current menu" row (spec section 34: "do not build a single
// mutable current menu table"). Editing October 2nd's menu can never
// touch October 1st's, because they are different rows entirely.
// `@@unique([propertyId, date])` is both the uniqueness guarantee (spec
// section 22) and what a concurrent "create today's menu" race resolves
// against - two simultaneous creates for the same property/date produce
// exactly one row and one P2002, translated to `MENU_ALREADY_EXISTS`
// (spec section 61), never a duplicate menu.
model Menu {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId     String
  property       Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  date   DateTime   @db.Date
  status MenuStatus @default(DRAFT)

  publishedAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items            MenuItem[]
  mealConsumptions MealConsumption[]

  @@unique([propertyId, date])
  @@index([organizationId])
  @@index([propertyId, status])
  @@map("menus")
}

// One dish/item within one meal of one menu. Deliberately per-menu, never
// a shared/reusable "dish catalog" (spec section 24: "do not hardcode
// food items") - OWNER/MANAGER type in whatever that day's kitchen is
// actually serving.
model MenuItem {
  id     String @id @default(uuid())
  menuId String
  menu   Menu   @relation(fields: [menuId], references: [id], onDelete: Cascade)

  mealType     MealType
  name         String
  description  String?
  isVegetarian Boolean  @default(true)
  isAvailable  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mealConsumptions MealConsumption[]

  @@index([menuId])
  @@index([menuId, mealType])
  @@map("menu_items")
}

// A record that a specific tenant actually had a specific meal on a
// specific date - deliberately NOT derived from the Menu at read time
// (spec section 40): `itemNamesSnapshot` freezes what was actually served
// at the moment of consumption, so a later edit to that day's `MenuItem`
// rows (spec section 40's Chole/Paneer example) can never rewrite what a
// tenant is recorded as having eaten. `menuId`/`menuItemId` are kept only
// for traceability (`onDelete: SetNull`/`Cascade` follow the menu's own
// lifecycle) - never re-read to reconstruct history.
//
// `@@unique([residencyId, mealDate, mealType])` prevents duplicate
// consumption for the same meal period (spec section 39) - a database
// constraint, not just an application-level check, so two concurrent
// "mark consumed" calls for the same tenant/meal/day can never both
// succeed.
model MealConsumption {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId     String
  property       Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  residencyId    String
  residency      Residency    @relation(fields: [residencyId], references: [id], onDelete: Cascade)
  menuId         String?
  menu           Menu?        @relation(fields: [menuId], references: [id], onDelete: SetNull)
  menuItemId     String?
  menuItem       MenuItem?    @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  mealType          MealType
  mealDate          DateTime              @db.Date
  itemNamesSnapshot String[]              @default([])
  consumedAt        DateTime              @default(now())
  source            MealConsumptionSource @default(STAFF_MARKED)
  markedByUserId    String?
  markedByUser      User?                 @relation("MealConsumptionMarkedBy", fields: [markedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([residencyId, mealDate, mealType], name: "meal_consumption_unique")
  @@index([organizationId])
  @@index([propertyId])
  @@index([tenantId, mealDate])
  @@index([menuId])
  @@map("meal_consumptions")
}

// ---------------------------------------------------------------------------
// Notifications & communication infrastructure (Phase 11)
//
// Notification (the logical message) and NotificationDelivery (one attempt
// per channel) are deliberately separate - the same "one notification, many
// delivery attempts" shape spec section 6 asks for. `Notification.type` is
// a plain string, not a Prisma enum, the same "grows independently, never
// needs a migration" reasoning already used for `AuditLog.action`/
// `entityType` (Phase 8) - see `src/modules/notifications/enums/
// notification-type.enum.ts` for the closed, documented set of values this
// project actually emits today.
// ---------------------------------------------------------------------------

enum NotificationStatus {
  UNREAD
  READ
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// Only the channel identity itself is a fixed, small enum (used for
// filtering/preference uniqueness) - unlike `type`, a new delivery channel
// is a genuinely rare, deliberate architectural addition, not something
// that should be addable by inserting a string.
enum NotificationChannel {
  IN_APP
  PUSH
  EMAIL
  WHATSAPP
  SMS
}

// IN_APP's own delivery is considered SENT the moment the Notification row
// exists (spec section 16 - "delivery means the notification exists for
// the user") - it never claims DELIVERED/FAILED for a channel this backend
// cannot actually confirm receipt for. PENDING exists for a channel whose
// provider call is still in flight; SKIPPED is the correct terminal state
// for a channel the user has disabled or that has no configured provider -
// never silently reported as DELIVERED.
enum NotificationDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  SKIPPED
}

enum PushPlatform {
  IOS
  ANDROID
  WEB
}

// Kept as an enum (not a bare string) for the same reason
// `PaymentProvider`/`WebhookProvider` are - a second push provider later is
// a new value, never a schema change to a free-form column whose values
// this backend also has to validate. EXPO is the only value the React
// Native/Expo mobile app actually needs; FCM/APNS are reserved for a
// future direct-provider integration.
enum PushTokenProvider {
  EXPO
  FCM
  APNS
}

// The logical message intended for one user (spec section 6-7) - never
// duplicated per channel. `organizationId`/`propertyId` are denormalized
// onto the row (the same pattern Phase 6's `Payment` and Phase 9's
// `Complaint` already use) purely for admin-facing aggregate queries -
// they are never re-derived from `data` and never trusted from a caller,
// always resolved server-side by whichever recipient resolver created the
// row. `idempotencyKey` is what actually prevents a retried business event
// from generating a duplicate notification (spec section 31/76) - always
// derived from the real business event (e.g.
// `RENT_PAYMENT_SUCCESS:<paymentId>`), never a random value, and enforced
// by a database-level `@unique`, not just an application pre-check.
model Notification {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  propertyId     String?
  property       Property?     @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  type           String
  title          String
  body           String
  data           Json?
  priority       NotificationPriority @default(NORMAL)
  status         NotificationStatus   @default(UNREAD)
  idempotencyKey String?              @unique
  readAt         DateTime?
  expiresAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries NotificationDelivery[]

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([userId, readAt])
  @@index([type])
  @@index([organizationId])
  @@map("notifications")
}

// One delivery attempt record per (notification, channel) - never a new
// row per retry (spec section 14/60: retries update `attemptCount`/
// `lastAttemptAt` on the same row in place). `provider` is a free string
// (`"IN_APP"`, `"NOOP"`, `"EXPO"`, ...) rather than an enum, deliberately -
// see `Notification.type`'s own doc comment for the same reasoning; unlike
// `channel` (a small, architecturally fixed set), which specific provider
// backs a channel is exactly the kind of thing this phase's own spec asks
// to keep pluggable without a migration.
model NotificationDelivery {
  id             String       @id @default(uuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  channel           NotificationChannel
  provider          String
  status            NotificationDeliveryStatus @default(PENDING)
  providerMessageId String?
  attemptCount      Int                        @default(0)
  lastAttemptAt     DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  failureReason     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([notificationId, channel], name: "notification_deliveries_notification_channel_unique")
  @@index([notificationId])
  @@index([status])
  @@index([channel])
  @@map("notification_deliveries")
}

// A user's own per-(notificationType, channel) opt-in/opt-out (spec
// section 20-21) - never a separate table per role (spec section 91: "do
// not create separate preference tables for OWNER/MANAGER/STAFF/TENANT" -
// role-based defaults are a code-level policy, computed at read/write
// time by `NotificationPreferencesService`, never stored per role here).
model NotificationPreference {
  id               String              @id @default(uuid())
  userId           String
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationType String
  channel          NotificationChannel
  enabled          Boolean             @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, notificationType, channel], name: "notification_preferences_user_type_channel_unique")
  @@index([userId])
  @@map("notification_preferences")
}

// A registered mobile/web push endpoint for one user (spec section 52-57).
// Generic by design - `provider`/`platform` are separate fields so this
// project is never hardcoded to Expo specifically, even though Expo is the
// only provider the React Native app needs today. `@@unique([provider,
// token])` (not a bare unique on `token`) is deliberate: two different
// providers could theoretically hand out overlapping opaque token strings,
// and scoping the constraint to the provider is what makes "re-register
// the same token" (spec section 55 - update in place, never duplicate)
// correctly idempotent per provider.
model PushDevice {
  id         String            @id @default(uuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform   PushPlatform
  provider   PushTokenProvider @default(EXPO)
  token      String
  deviceId   String?
  appVersion String?
  isActive   Boolean           @default(true)
  lastSeenAt DateTime          @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, token], name: "push_devices_provider_token_unique")
  @@index([userId])
  @@index([userId, isActive])
  @@map("push_devices")
}

// ---------------------------------------------------------------------------
// Tenant discovery, applications & visits (Phase 12)
//
// The tenant ACQUISITION funnel, sitting strictly upstream of Phase 4's
// OPERATIONAL tenancy layer (Tenant -> Residency -> BedAllocation):
//   PropertyListing (public discovery) -> TenantApplication (an applicant's
//   interest) -> PropertyVisit (an optional site visit) -> approval ->
//   (manual, separate) onboarding via the existing Tenant/Residency APIs.
// This phase never creates a Residency/BedAllocation/Invoice/Payment - see
// README's "Phase 12" section and ApplicationConversionService's own doc
// comment for the exact boundary.
// ---------------------------------------------------------------------------

enum ListingStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

// Kept small and generic on purpose - the same "escape hatch, not a
// combinatorial explosion of booleans" reasoning as RoomType/
// ComplaintCategory elsewhere in this schema.
enum Amenity {
  WIFI
  LAUNDRY
  PARKING
  AC
  POWER_BACKUP
  HOUSEKEEPING
  SECURITY
  CCTV
  FOOD
  GYM
  COMMON_AREA
}

// No DRAFT here - unlike TenantApplication's owner-facing counterpart
// (ListingStatus.DRAFT), there is no save-and-resume application UX in
// this phase, so SUBMITTED is the initial state. EXPIRED is a lazily/
// batch-applied terminal state - see
// TenantApplicationsService.expireStaleApplications (no cron infra exists
// yet, spec: do not add a scheduler dependency for this).
enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  VISIT_SCHEDULED
  APPROVED
  REJECTED
  WITHDRAWN
  EXPIRED
}

enum VisitStatus {
  REQUESTED
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// The public-facing discovery representation of a Property - deliberately
// not a duplicate of Property itself (name/address/type stay on Property;
// this table only ever adds *marketing* fields: title/description/
// locality/coverImageUrl/amenities/indicative price). One listing per
// property (`@@unique` on `propertyId`) - a property is either not listed,
// or has exactly one (draft/published/unpublished) listing, never several
// competing ones.
//
// `startingFromPrice` is deliberately NOT derived from RentPlan - Phase 5
// confirmed rent plans are per-residency (tenant-specific, only exist once
// someone has actually moved in), so there is no tenant-agnostic "rent
// rate" to read publicly. This field is a manually-maintained, indicative-
// only figure the owner sets themselves - never treated as a quote or
// binding price anywhere in this module.
model PropertyListing {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId     String        @unique
  property       Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  status         ListingStatus @default(DRAFT)

  title             String?
  description       String?
  // Denormalized from Property.city at publish time for query performance
  // (a public discovery search filters by city/locality far more often
  // than it changes) - PropertiesService/PropertyListingsService keep it
  // in sync whenever the listing is created/updated.
  city              String?
  locality          String?
  latitude          Float?
  longitude         Float?
  coverImageUrl     String?
  contactEnabled    Boolean  @default(true)
  startingFromPrice Decimal? @db.Decimal(12, 2)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  amenities    PropertyListingAmenity[]
  applications TenantApplication[]

  @@index([organizationId])
  @@index([status])
  @@index([city])
  @@index([locality])
  @@map("property_listings")
}

// A simple normalized join table rather than a comma-joined string column
// or a wide table of boolean columns (spec: "prefer a normalized-but-
// simple model over overengineering") - `@@unique` prevents the same
// amenity being recorded twice for one listing.
model PropertyListingAmenity {
  id                String          @id @default(uuid())
  propertyListingId String
  propertyListing   PropertyListing @relation(fields: [propertyListingId], references: [id], onDelete: Cascade)
  amenity           Amenity

  createdAt DateTime @default(now())

  @@unique([propertyListingId, amenity])
  @@index([propertyListingId])
  @@map("property_listing_amenities")
}

// An applicant's expression of interest in a property, prior to becoming a
// Tenant (Phase 4). `applicantUserId` is nullable - a guest/public
// applicant has no User yet; if the request was authenticated,
// TenantApplicationsService auto-links it. `internalReviewNotes` is never
// exposed to the applicant or in any public response DTO -
// `rejectionReason` is the only owner-authored text an applicant may see.
//
// Duplicate-prevention: a partial unique index (added by hand in this
// phase's migration SQL, the same pattern Residency/BedAllocation already
// use for a conditional uniqueness rule Prisma's schema DSL cannot
// express) prevents more than one *active* (status not in REJECTED/
// WITHDRAWN/EXPIRED) application for the same (property, applicant)
// pair - keyed by applicantUserId when present, else normalized phone, so
// both authenticated and guest applicants are covered:
//   CREATE UNIQUE INDEX tenant_applications_active_applicant_property_unique
//     ON tenant_applications (property_id, COALESCE(applicant_user_id::text, phone))
//     WHERE status NOT IN ('REJECTED', 'WITHDRAWN', 'EXPIRED');
model TenantApplication {
  id                String           @id @default(uuid())
  organizationId    String
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId        String
  property          Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyListingId String?
  propertyListing   PropertyListing? @relation(fields: [propertyListingId], references: [id], onDelete: SetNull)
  applicantUserId   String?
  applicantUser     User?            @relation("ApplicationApplicant", fields: [applicantUserId], references: [id], onDelete: SetNull)

  fullName              String
  phone                 String
  email                 String?
  status                ApplicationStatus @default(SUBMITTED)
  preferredMoveInDate   DateTime?
  preferredRoomType     RoomType?
  preferredStayDuration Int?
  notes                 String?
  rejectionReason       String?
  internalReviewNotes   String?

  reviewedByUserId String?
  reviewedByUser   User?     @relation("ApplicationReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?
  decisionAt       DateTime?

  // Concurrency guard for ApplicationConversionService.startOnboarding -
  // set via a conditional updateMany so two concurrent onboarding calls
  // for the same application can never both "win" and create two Tenants.
  onboardingStartedAt DateTime?

  submittedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  activities ApplicationActivity[]
  visits     PropertyVisit[]

  @@index([organizationId])
  @@index([propertyId])
  @@index([applicantUserId])
  @@index([status])
  @@index([createdAt])
  @@index([preferredMoveInDate])
  @@map("tenant_applications")
}

// A permanent, append-only business-history record of what happened to an
// application - deliberately separate from AuditLog (Phase 8's platform-
// admin audit trail, a different reader with a different purpose), even
// though some of the same events are written to both (see
// TenantApplicationsService/ApplicationLifecycleService for which ones).
model ApplicationActivity {
  id            String            @id @default(uuid())
  applicationId String
  application   TenantApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actorUserId   String?
  actorUser     User?             @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action        String
  metadata      Json?

  createdAt DateTime @default(now())

  @@index([applicationId])
  @@map("application_activities")
}

// A site visit tied to exactly one TenantApplication. `scheduledStartAt`/
// `scheduledEndAt` are both nullable - a REQUESTED visit (applicant-
// initiated, no time chosen yet) has neither; they are set when an
// OWNER/MANAGER moves the visit to SCHEDULED. Conflict detection (no two
// SCHEDULED visits at the same property with overlapping time ranges) is
// enforced in PropertyVisitsService, inside a transaction using a
// Postgres advisory lock keyed by propertyId (`pg_advisory_xact_lock`) to
// close the SELECT-then-write race window under real concurrency - see
// PropertyVisitsService.assertNoConflict for the exact mechanism, mirroring
// the level of rigor BedAllocation's partial-unique-index +
// transaction combination already established for a different kind of
// conflict.
model PropertyVisit {
  id              String            @id @default(uuid())
  organizationId  String
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId      String
  property        Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  applicationId   String
  application     TenantApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicantUserId String?
  applicantUser   User?             @relation("VisitApplicant", fields: [applicantUserId], references: [id], onDelete: SetNull)

  scheduledStartAt DateTime?
  scheduledEndAt   DateTime?
  status           VisitStatus @default(REQUESTED)
  notes            String?
  cancelReason     String?

  createdByUserId String
  createdByUser   User   @relation("VisitCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([propertyId])
  @@index([applicationId])
  @@index([scheduledStartAt])
  @@index([status])
  @@map("property_visits")
}
